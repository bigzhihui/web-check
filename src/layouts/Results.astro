---
import PageLayout from '@layouts/Page.astro';
import NavBar from '@components/scafold/Nav.astro';
import Footer from '@components/scafold/Footer.astro';
import ScanForm from '@components/form/ScanForm.astro';
import Main from '../client/main.tsx';
import { determineAddressType } from '../client/utils/address-type-checker';
import '../client/styles/index.css';

interface Props {
  title: string;
  description?: string;
  target?: string;
  tool?: { name: string; href: string };
}

const { target, tool, ...page } = Astro.props;

// Scanned site for the header, when the path holds a single address
const site = target?.includes('/') ? undefined : target?.replace(/^www\./, '');
---

<PageLayout {...page}>
  <link
    slot="head"
    href="/fonts/PTMono-Regular.woff2"
    as="font"
    rel="preload"
    type="font/woff2"
    crossorigin="anonymous"
  />
  {site ? (
    <NavBar slot="nav">
      {tool && (
        <a slot="tool" class="tool" href={tool.href}>
          {tool.name}
        </a>
      )}
      <div class="site">
        {determineAddressType(site) === 'url' && (
          <a
            href={`https://${target}`}
            target="_blank"
            rel="noreferrer"
            aria-label={`访问 ${site}`}
          >
            <img src="/favicon.svg" alt="" width="32" height="32" />
          </a>
        )}
        <h1>{site}</h1>
      </div>
    </NavBar>
  ) : (
    <NavBar slot="nav" />
  )}
  <div class="scan-again">
    <ScanForm label="检测其他网站" buttonLabel="开始检测" />
    <a class="retry-current" href={Astro.url.pathname} data-astro-reload>
      重新检测当前网站
    </a>
  </div>
  <Main client:only="react" />
  <Footer slot="footer" miniView />
</PageLayout>

<style lang="scss">
  .scan-again {
    display: flex;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    margin-bottom: 1.5rem;
    padding: 1rem;
    border: 1px solid var(--primary-transparent);
    border-radius: 4px;
    background: var(--background-raised);

    :global(.scan-form) {
      flex: 1 1 30rem;
    }

    .retry-current {
      align-self: center;
      color: var(--primary);
      font-size: 0.9rem;
    }
  }

  .tool {
    padding: 0.3rem 0.8rem;
    border: 1px solid var(--primary-transparent);
    border-radius: 2rem;
    font-size: 0.9rem;
    font-weight: 600;
    transition: border-color 0.25s ease;

    &:hover,
    &:focus-visible {
      border-color: var(--primary);
      text-decoration: none;
    }
  }

  .site {
    display: flex;
    align-items: center;
    gap: 0.5rem;

    img {
      display: block;
      border-radius: 4px;
      width: 2rem;
    }

    h1 {
      margin: 0;
      font-size: 1.5rem;
      overflow-wrap: anywhere;
    }
  }
</style>

<style is:global>
  body {
    --page-width: min(94vw, 2200px);
    --main-padding: 2rem 0;
  }
</style>
