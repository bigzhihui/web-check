---
import PageLayout from '@layouts/Page.astro';
import { checks, checkIds } from '@/data/checks';
---

<PageLayout
  title="检测项目说明 | 十三月网站检测"
  description="查看本站已启用的网站基础检测项目，了解各项查询内容、适用范围，并进入对应的单项检测入口。"
>
  <h1>检测项目说明</h1>
  <p>本站提供以下公网网站基础检测。选择项目可查看说明并单独检测。</p>
  <ul>
    {checkIds.map((id) => (
      <li>
        <a href={`/${id}`}>{checks[id].title}</a>：{checks[id].summary}
      </li>
    ))}
  </ul>
</PageLayout>
<style>
  li {
    margin: 1rem 0;
    line-height: 1.8;
  }
</style>
